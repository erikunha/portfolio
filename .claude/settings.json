{
  "permissions": {
    "deny": [
      "Bash(git add .:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(yarn:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(fallow fix:*)",
      "Bash(npx fallow fix:*)",
      "Bash(npx fallow@2.95.0 fix:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/stop-verify.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
