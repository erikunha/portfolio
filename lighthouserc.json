{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/pt",
        "http://localhost:3000/cv",
        "http://localhost:3000/summary",
        "http://localhost:3000/links",
        "http://localhost:3000/links/en",
        "http://localhost:3000/design-system",
        "http://localhost:3000/design-system/tokens",
        "http://localhost:3000/design-system/components",
        "http://localhost:3000/design-system/enforcement",
        "http://localhost:3000/design-system/changelog",
        "http://localhost:3000/design-system/foundations/colors",
        "http://localhost:3000/design-system/foundations/typography",
        "http://localhost:3000/design-system/foundations/spacing-borders",
        "http://localhost:3000/design-system/primitives/badge",
        "http://localhost:3000/design-system/primitives/brand-icon",
        "http://localhost:3000/design-system/primitives/button",
        "http://localhost:3000/design-system/primitives/cmd-line",
        "http://localhost:3000/design-system/primitives/copybutton",
        "http://localhost:3000/design-system/primitives/field",
        "http://localhost:3000/design-system/primitives/kbd-key",
        "http://localhost:3000/design-system/primitives/stat-tile",
        "http://localhost:3000/design-system/primitives/terminal-panel",
        "http://localhost:3000/design-system/primitives/window-chrome"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1.0 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "interaction-to-next-paint": "off",
        "interactive": ["error", { "maxNumericValue": 2500 }],

        "document-latency-insight": ["error", { "minScore": 1 }],
        "image-delivery-insight": ["error", { "minScore": 1 }],
        "render-blocking-insight": ["warn", { "maxLength": 3 }],
        "font-display-insight": ["error", { "minScore": 1 }],

        "color-contrast": "error",
        "aria-required-attr": "error",
        "label": "error",
        "heading-order": "error",
        "html-has-lang": "error",

        "is-crawlable": "error",
        "robots-txt": "error",
        "structured-data": "off",

        "tap-targets": "off",
        "forced-reflow-insight": "off",
        "network-dependency-tree-insight": "off",

        "label-content-name-mismatch": "error",
        "unused-javascript": ["warn", { "maxNumericValue": 60 }],
        "dom-size-insight": ["warn", { "maxNumericValue": 1500 }],
        "cache-insight": ["warn", { "minScore": 1 }],
        "unused-css-rules": ["warn", { "maxLength": 10 }],
        "errors-in-console": "error",

        "bf-cache": "warn",
        "valid-source-maps": "off",
        "unminified-css": "warn",
        "unminified-javascript": "warn",
        "cls-culprits-insight": "off",
        "duplicated-javascript-insight": "off",
        "inp-breakdown-insight": "off",
        "lcp-breakdown-insight": "off",
        "lcp-discovery-insight": "off",
        "legacy-javascript-insight": "off",
        "modern-http-insight": "off",
        "non-composited-animations": "off",
        "third-parties-insight": "off",
        "viewport-insight": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
