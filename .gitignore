# deps
/node_modules

# next
/.next
/out/

# production
/build

# env files — the wildcard is the point. A NEW environment name (`.env.preview`,
# `.env.staging`, `.env.local`) must be ignored the moment someone types it, without
# a line being added for it by hand, and the example file is the single tracked
# exception. `.env*` covers the dot-prefixed family; `*.env` covers the suffix
# family (`production.env`), which the dot form does NOT match. Both shapes are
# asserted by __tests__/meta/gitignore-env-files.test.ts, so the two families
# cannot drift apart silently.
.env
.env*
.env*.local
!.env.example
*.env

# credential files — a private key, a keystore or a service credential is never a
# repo artifact, at any depth, in any directory. Same gate as the env block.
*.pem
*.key
*.p12
*.pfx
*credentials*.json

# vercel
.vercel

# testing
/coverage
/coverage-report
/test-results
/playwright-report
/.playwright-results/

# local build artifact (next-build/ used by gates:runtime --skip-build)
/next-build

# lighthouse ci artifact reports
/.lighthouseci/

# local gates-runtime LHCI filesystem output
/.lhci-local/

# ai-eval harness output (scripts/ask-eval.ts)
/ask-eval-result.json

# personal Claude Code files
CLAUDE.local.md
.claude/settings.local.json
.claude/*.local.md

# playwright mcp session logs
.playwright-mcp/

tsconfig.tsbuildinfo

# leftover artifacts of the review chain deleted 2026-07-27 — no writer remains
.review-passed
.review-findings.json
.review-findings-archive.jsonl

# leftover inbox from the learning loop deleted 2026-07-27 — no writer remains
.review-learnings.md


# git worktrees (isolated workspaces for parallel branch work)
.worktrees/

# spec-driven-development scratch: progress ledger, review packages, archived patches.
# The subagent-driven-development skill treats this as git-ignored scratch and
# warns `git clean -fdx` destroys it; never tracked, absent from origin/main.
# No trailing slash: that makes a rule directory-only, so it misses a symlink of
# the same name — why /.next dropped its slash in 60b19c2. Proven by RULE_MATRIX
# in __tests__/meta/gitignore-worktree-symlinks.test.ts.

# spec-kit, in full: the engine, the generated skills, and the feature output.
# Personal dev flow, tracked nowhere: an installed tool, never a repo
# artifact. Reinstall with `specify init --here --integration claude`
# and `specify extension add bug`. The durable why lives in DECISIONS.md /
# ARCHITECTURE.md, which is where this repo's own rule puts it.
specs
.specify
.claude/skills/speckit-*

# legacy spec/plan output from the previous SDD tooling. The rules stay even
# though the tooling is gone: a stale local copy must not become stageable on a
# branch whose whole subject is stopping a broad `git add` from sweeping files
# nobody chose. No trailing slash, same symlink reason as above.
docs/superpowers
.superpowers

# os
.DS_Store

# git worktree symlinks (.claude/worktrees/)
.claude/worktrees/

# session-owned lock file — machine-generated runtime state, not source
.claude/scheduled_tasks.lock

# Semgrep local SARIF output
semgrep.sarif
gitleaks.sarif

# Stryker mutation testing output — transient sandbox + generated reports
.stryker-tmp/
mutation-report.html
mutation-report.json
.stryker-incremental.json

# Vendored Python bytecode
__pycache__/
*.pyc
.vitest/

# weekly metrics output (scripts/metrics); history lives in a workflow artifact
/metrics/weekly.json
/metrics/breaches.json

# scratch scripts written at the repository root by a local demo (.ll_demo_*.mjs,
# .ll_dbg_*.mjs, .probe_scroll.mjs and whatever name they take next): they are
# throwaway, they are never tracked, and Biome lints the working tree, so one
# of them breaks the pre-commit hook for whoever is committing next
/.*.mjs
