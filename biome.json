{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!out",
      "!dist",
      "!design-system/dist",
      "!coverage",
      "!public",
      "!prototype",
      "!scaffold",
      "!.claude/worktrees",
      "!.worktrees",
      "!.lighthouseci",
      "!.playwright-results",
      "!app/globals.css",
      "!next-env.d.ts",
      "!.specify",
      "!.claude/skills/speckit-*",
      "!pnpm-lock.yaml",
      "!CLAUDE.md",
      "!DECISIONS.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error",
        "noPlaywrightMissingAwait": "error",
        "noUnknownFunction": {
          "level": "error",
          "options": {
            "ignore": ["theme"]
          }
        },
        "usePlaywrightValidDescribeCallback": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "noUnusedTemplateLiteral": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "warn",
        "noNestedTernary": "error",
        "useVarsOnTop": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/image": {
                "importNames": ["default"],
                "message": "The default next/image export is a client component that ships its runtime to every route that renders it. Use components/OptimizedImage (getImageProps on the server)."
              }
            }
          }
        }
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["log", "info", "warn", "error"]
          }
        },
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "warn",
        "noImportCycles": "error",
        "noLeakedRender": "error",
        "noLoopFunc": "error",
        "noDuplicateSelectors": "error",
        "noIdenticalTestTitle": "error"
      },
      "complexity": {
        "noUselessFragments": "error",
        "noBannedTypes": "error",
        "useArraySome": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noPlaywrightUselessAwait": "error",
        "useMathMinMax": "error",
        "useRegexpTest": "error"
      },
      "security": {
        "useIframeSandbox": "error"
      },
      "performance": {
        "useDomNodeTextContent": "error"
      },
      "nursery": {
        "noTailwindRawColors": "error"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.md", "**/*.mdx", "**/*.yml", "**/*.yaml"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "app/api/**/*.ts",
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "!lib/env.ts",
        "!lib/env-build.ts",
        "!lib/**/*.test.ts",
        "!lib/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "!lib/rate-limit.ts",
        "!lib/**/*.test.ts",
        "!lib/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/image": {
                    "importNames": ["default"],
                    "message": "The default next/image export is a client component that ships its runtime to every route that renders it. Use components/OptimizedImage (getImageProps on the server)."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/app/**", "@/components/**"],
                    "message": "lib imports neither app nor components: the dependency points from the UI to lib."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["lib/rate-limit.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/image": {
                    "importNames": ["default"],
                    "message": "The default next/image export is a client component that ships its runtime to every route that renders it. Use components/OptimizedImage (getImageProps on the server)."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/app/**", "@/components/**"],
                    "message": "lib imports neither app nor components: the dependency points from the UI to lib."
                  },
                  {
                    "group": ["@/lib/ask", "@/lib/ask/**", "@/lib/eval", "@/lib/eval/**"],
                    "message": "lib/rate-limit.ts stays independent of the ask and eval modules that depend on it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["content/**/*.ts", "!content/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/image": {
                    "importNames": ["default"],
                    "message": "The default next/image export is a client component that ships its runtime to every route that renders it. Use components/OptimizedImage (getImageProps on the server)."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/**", "!@/content/**"],
                    "message": "content imports only content and zod."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "design-system/**/*.ts",
        "design-system/**/*.tsx",
        "!design-system/**/*.test.ts",
        "!design-system/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/image": {
                    "importNames": ["default"],
                    "message": "The default next/image export is a client component that ships its runtime to every route that renders it. Use components/OptimizedImage (getImageProps on the server)."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "!@/lib/cn",
                      "!@/lib/join-class-names",
                      "!@/design-system",
                      "!@/design-system/**"
                    ],
                    "message": "design-system imports only @/lib/cn and @/lib/join-class-names besides its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    }
  ]
}
