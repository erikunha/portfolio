{
  "name": "erik-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "gitleaks:staged": "node scripts/gitleaks-staged.mjs",
    "gitleaks:fixture": "node scripts/check-gitleaks-fixture.mjs",
    "check:tool-pins": "node scripts/check-tool-pins.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "validate-content": "tsx scripts/validate-content.ts",
    "generate:og": "tsx scripts/generate-og-image.ts",
    "generate:icons": "tsx scripts/generate-brand-icons.ts",
    "ask:eval": "TSX_TSCONFIG_PATH=scripts/tsconfig.eval.json tsx scripts/ask-eval.ts",
    "eval:agents": "TSX_TSCONFIG_PATH=scripts/tsconfig.eval.json tsx scripts/agent-eval.ts",
    "bundle-check": "node scripts/check-bundle-size.mjs",
    "route-js-check": "node scripts/check-route-js.mjs",
    "check:client-naming": "node scripts/check-client-naming.mjs",
    "check:dep-pinning": "node scripts/check-dep-pinning.mjs",
    "check:dependency-vetting": "tsx scripts/check-dependency-vetting.ts",
    "check:component-docs": "node scripts/check-component-docs-coverage.mjs",
    "check:harness-size": "node scripts/check-harness-size.mjs",
    "check:section-order": "node scripts/check-section-order.mjs",
    "check:doc-drift": "node scripts/check-doc-drift.mjs",
    "check:detect-changes-paths": "node scripts/check-detect-changes-paths.mjs",
    "check:test-integrity": "tsx scripts/check-test-integrity.ts",
    "lint:contrast": "node scripts/contrast-check.mjs",
    "lint:css-tokens": "tsx scripts/lint-css-tokens.ts",
    "lint:semgrep": "node scripts/run-semgrep.mjs --error --sarif semgrep.sarif",
    "lint:semgrep:selftest": "node scripts/check-semgrep-fixture.mjs",
    "pr:gate": "tsx scripts/check-pr-comments.ts",
    "test:mutation": "stryker run",
    "verify": "pnpm check && pnpm typecheck && pnpm validate-content && pnpm check:client-naming && pnpm check:dep-pinning && pnpm check:dependency-vetting && pnpm check:harness-size && pnpm check:component-docs && pnpm check:section-order && pnpm check:doc-drift && pnpm check:detect-changes-paths && pnpm check:test-integrity && pnpm lint:contrast && pnpm lint:css-tokens && pnpm test:coverage",
    "ci": "pnpm verify && pnpm build && pnpm bundle-check && pnpm route-js-check",
    "ci:local": "pnpm verify",
    "ci:predict": "tsx scripts/ci-predict.ts",
    "gates:runtime": "tsx scripts/gates-runtime.ts",
    "prepare": "node scripts/prepare-hooks.mjs",
    "postinstall": "node scripts/strip-next-polyfills.mjs",
    "changelog:sync": "tsx scripts/sync-changelog.ts",
    "check:mutation-canary": "node scripts/check-mutation-kills.mjs --canary"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ],
    "overrides": {
      "@hono/node-server": "^2.0.5",
      "@lhci/cli>chrome-launcher": "^1.2.2",
      "@puppeteer/browsers": "^3.2.6",
      "@stryker-mutator/core>minimatch": "^11.0.3",
      "axios": "^1.18.0",
      "basic-ftp": "^6.2.3",
      "body-parser@1": "^1.20.9",
      "body-parser@>=2": "^2.3.0",
      "brace-expansion": "^5.0.12",
      "browserslist": "^4.29.4",
      "chromium-bidi>zod": "^4.6.7",
      "compression": "^1.8.2",
      "esbuild": "^0.28.2",
      "fast-uri@3": "^3.1.9",
      "follow-redirects": "^1.16.2",
      "hono": "^4.12.34",
      "ip-address": "^10.7.4",
      "joi": "^18.3.1",
      "js-yaml": "^4.3.1",
      "lodash": "^4.18.1",
      "minimatch@10": "^11.0.1",
      "postcss": "^8.5.31",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "sharp": "^0.35.0",
      "tmp": "^0.2.6",
      "undici@7": "^7.29.0",
      "uuid": "^14.0.3",
      "vite": "^8.1.6",
      "proxy-agent": "^8.0.1"
    }
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.164",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@next/mdx": "~16.4.5",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.164",
    "clsx": "^2.1.1",
    "langfuse-vercel": "^3.39.2",
    "mcp-handler": "^2.3.1",
    "next": "~16.4.5",
    "pino": "^10.4.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rehype-pretty-code": "~0.14.6",
    "remark-gfm": "^4.0.1",
    "resend": "^6.37.0",
    "shiki": "~4.6.0",
    "zod": "~4.6.7"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "not dead"
  ],
  "devDependencies": {
    "@argos-ci/playwright": "^7.8.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "~2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "~1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "pino-pretty": "^13.2.0",
    "playwright": "~1.65.0",
    "postcss": "^8.5.32",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  }
}
