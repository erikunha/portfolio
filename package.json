{
  "name": "erik-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check": "biome check --error-on-warnings .",
    "check:staged": "biome check --staged --error-on-warnings --no-errors-on-unmatched",
    "check:fix": "biome check --write .",
    "gitleaks:staged": "tsx scripts/gates/gitleaks-staged.ts",
    "gitleaks:fixture": "tsx scripts/gates/check-gitleaks-fixture.ts",
    "check:tool-pins": "tsx scripts/gates/check-tool-pins.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "validate-content": "tsx scripts/gates/validate-content.ts",
    "generate:og": "tsx scripts/codegen/generate-og-image.ts",
    "generate:icons": "tsx scripts/codegen/generate-brand-icons.ts",
    "generate:discovery": "tsx scripts/codegen/generate-discovery-files.ts",
    "ask:eval": "TSX_TSCONFIG_PATH=scripts/eval/tsconfig.eval.json tsx scripts/eval/ask-eval.ts",
    "bundle-check": "tsx scripts/gates/check-bundle-size.ts",
    "route-js-check": "tsx scripts/gates/check-route-js.ts",
    "check:client-naming": "tsx scripts/gates/check-client-naming.ts",
    "check:shell-dom-writes": "tsx scripts/gates/check-shell-dom-writes.ts",
    "check:css-ownership": "tsx scripts/gates/check-css-ownership.ts",
    "check:dep-pinning": "tsx scripts/gates/check-dep-pinning.ts",
    "check:dependency-vetting": "tsx scripts/gates/check-dependency-vetting.ts",
    "check:component-docs": "tsx scripts/gates/check-component-docs-coverage.ts",
    "check:harness-size": "tsx scripts/gates/check-harness-size.ts",
    "check:section-order": "tsx scripts/gates/check-section-order.ts",
    "check:doc-drift": "tsx scripts/gates/check-doc-drift.ts",
    "check:no-dashes": "tsx scripts/gates/check-no-dashes.ts",
    "check:detect-changes-paths": "tsx scripts/gates/check-detect-changes-paths.ts",
    "check:test-integrity": "tsx scripts/gates/check-test-integrity.ts",
    "lint:contrast": "tsx scripts/gates/contrast-check.ts",
    "lint:css-tokens": "tsx scripts/gates/lint-css-tokens.ts",
    "lint:semgrep": "tsx scripts/gates/run-semgrep.ts --error --sarif semgrep.sarif",
    "lint:semgrep:selftest": "tsx scripts/gates/check-semgrep-fixture.ts",
    "lint:semgrep:fp-baseline": "tsx scripts/gates/measure-semgrep-fp.ts",
    "test:mutation": "stryker run",
    "verify": "tsx scripts/ci/verify.ts",
    "ci": "pnpm verify && pnpm build && pnpm bundle-check && pnpm route-js-check",
    "ci:local": "pnpm verify",
    "ci:full": "tsx scripts/ci/ci-full.ts",
    "doctor": "tsx scripts/ci/doctor.ts",
    "gates:runtime": "tsx scripts/ci/gates-runtime.ts",
    "prepare": "node scripts/install/prepare-hooks.ts",
    "docs:feature-map": "tsx scripts/codegen/feature-map.ts",
    "decisions:index": "tsx scripts/codegen/decisions-index.ts",
    "check:decisions-index": "tsx scripts/codegen/decisions-index.ts --check",
    "changelog:sync": "tsx scripts/codegen/sync-changelog.ts",
    "check:mutation-canary": "tsx scripts/gates/check-mutation-kills.ts --canary"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ],
    "overrides": {
      "@lhci/cli>chrome-launcher": "^1.2.2",
      "@puppeteer/browsers": "^3.2.6",
      "@stryker-mutator/core>minimatch": "^11.0.3",
      "axios": "^1.18.0",
      "basic-ftp": "^6.2.4",
      "body-parser@1": "^1.20.9",
      "brace-expansion": "^5.0.12",
      "browserslist": "^4.29.4",
      "chromium-bidi>zod": "^4.6.7",
      "compression": "^1.8.2",
      "esbuild": "^0.28.2",
      "fast-uri@3": "^3.1.9",
      "follow-redirects": "^1.16.2",
      "ip-address": "^10.7.4",
      "joi": "^18.3.1",
      "js-yaml": "^4.3.1",
      "lodash": "^4.18.1",
      "minimatch@10": "^11.0.1",
      "postcss": "^8.5.32",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "sharp": "^0.35.0",
      "tmp": "^0.2.6",
      "undici@7": "^7.29.0",
      "uuid": "^14.0.3",
      "vite": "^8.3.6",
      "proxy-agent": "^8.0.1"
    },
    "patchedDependencies": {
      "next@16.4.6": "patches/next@16.4.6.patch"
    }
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.164",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@next/mdx": "~16.4.6",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.164",
    "clsx": "^2.1.1",
    "langfuse-vercel": "^3.39.2",
    "mcp-handler": "^2.3.1",
    "next": "~16.4.6",
    "pino": "^10.4.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rehype-pretty-code": "~0.14.6",
    "remark-gfm": "^4.0.1",
    "resend": "^6.37.0",
    "shiki": "~4.6.0",
    "zod": "~4.6.7"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "not dead"
  ],
  "devDependencies": {
    "@argos-ci/playwright": "^7.8.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "~2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "~1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "pino-pretty": "^13.2.0",
    "playwright": "~1.65.0",
    "postcss": "^8.5.32",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  }
}
